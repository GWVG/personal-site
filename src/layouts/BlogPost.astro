---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, ogImage, draft } = Astro.props;
const social = ogImage ?? heroImage;
const socialUrl = social ? new URL(social.src, Astro.site).href : undefined;
---

<BaseLayout title={title} description={description} ogImage={socialUrl} ogType="article">
	<main class="blog-post">
		<article>
			<header class="post-header">
				<p class="post-date">
					{draft && <span class="draft-badge">Draft</span>}
					<FormattedDate date={pubDate} />
					{
						updatedDate && (
							<span class="updated">
								· updated <FormattedDate date={updatedDate} />
							</span>
						)
					}
				</p>
				<h1 class="post-title">{title}</h1>
				<p class="post-desc">{description}</p>
				<hr class="header-rule" />
			</header>
			{
				heroImage && (
					<div class="hero-image">
						<Image src={heroImage} alt="" widths={[720, 1440]} sizes="(max-width: 720px) 100vw, 720px" />
					</div>
				)
			}
			<div class="prose">
				<slot />
			</div>
		</article>
	</main>
</BaseLayout>

<style>
	.blog-post {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: calc(var(--nav-h) + 3.5em) 1em 5em;
	}

	.post-header {
		margin-bottom: 3rem;
	}

	.post-date {
		font-size: 0.8rem;
		font-weight: 300;
		color: rgb(var(--gray));
		margin: 0 0 1rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.draft-badge {
		color: var(--accent);
		border: 1px solid var(--accent);
		padding: 0.1rem 0.4rem;
		margin-right: 0.6rem;
		border-radius: 2px;
	}

	.post-title {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3.5rem);
		font-weight: 700;
		color: rgb(var(--black));
		margin: 0 0 1.25rem;
		line-height: 1.05;
		text-transform: uppercase;
		letter-spacing: 0.02em;
	}

	.post-desc {
		font-size: 1rem;
		font-weight: 300;
		color: rgb(var(--gray));
		line-height: 1.6;
		margin: 0;
	}

	.header-rule {
		margin-top: 2rem;
		border: none;
		border-top: 1px solid rgb(var(--gray-light));
	}

	.hero-image {
		margin-bottom: 3rem;
	}

	.hero-image img {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 4px;
	}

	.prose {
		font-size: 1rem;
	}

	:global(.prose code) {
		font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, monospace;
		font-size: 0.85em;
	}

	:global(.prose pre code) {
		font-size: 0.82rem;
		line-height: 1.65;
	}

	/* SVG figures (charts, diagrams) render at their own width, never upscaled. */
	:global(.prose figure.prose-figure img[src*='.svg']) {
		width: auto;
		max-width: 100%;
		margin: 0 auto;
	}

	/* Portrait images (phone screenshots): name the file *-narrow.* to cap the width. */
	:global(.prose figure.prose-figure img[src*='-narrow']) {
		width: auto;
		max-width: min(100%, 320px);
		margin: 0 auto;
	}
</style>
