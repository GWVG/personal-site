---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, draft } = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage} ogType="article">
	<main class="blog-post">
		<article>
			<header class="post-header">
				<p class="post-date">
					{draft && <span class="draft-badge">Draft</span>}
					<FormattedDate date={pubDate} />
					{
						updatedDate && (
							<span class="updated">
								· updated <FormattedDate date={updatedDate} />
							</span>
						)
					}
				</p>
				<h1 class="post-title">{title}</h1>
				<p class="post-desc">{description}</p>
				<hr class="header-rule" />
			</header>
			{
				heroImage && (
					<div class="hero-image">
						<Image src={heroImage} alt="" widths={[720, 1440]} sizes="(max-width: 720px) 100vw, 720px" />
					</div>
				)
			}
			<div class="prose">
				<slot />
			</div>
		</article>
	</main>
</BaseLayout>

<script>
	// Renders ```mermaid fences client-side. The library is only fetched when a
	// page actually contains a diagram; without JS the source stays readable.
	async function renderMermaid() {
		const blocks = document.querySelectorAll<HTMLElement>('pre > code.language-mermaid');
		if (blocks.length === 0) return;

		const { default: mermaid } = await import('mermaid');
		const css = getComputedStyle(document.documentElement);
		const rgb = (name: string) => `rgb(${css.getPropertyValue(name).trim()})`;

		mermaid.initialize({
			startOnLoad: false,
			theme: 'base',
			darkMode: true,
			fontFamily: 'inherit',
			themeVariables: {
				background: '#0f0f0f',
				primaryColor: rgb('--gray-light'),
				primaryTextColor: rgb('--black'),
				primaryBorderColor: css.getPropertyValue('--accent').trim(),
				lineColor: rgb('--gray'),
				secondaryColor: '#0f0f0f',
				tertiaryColor: '#161514',
				clusterBkg: '#161514',
				clusterBorder: rgb('--gray-light'),
				edgeLabelBackground: '#0f0f0f',
			},
		});

		const nodes: HTMLElement[] = [];
		blocks.forEach((code) => {
			const pre = code.parentElement!;
			const div = document.createElement('div');
			div.className = 'mermaid-diagram';
			div.textContent = code.textContent ?? '';
			pre.replaceWith(div);
			nodes.push(div);
		});
		await mermaid.run({ nodes });
	}
	renderMermaid();
</script>

<style>
	.blog-post {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		padding: calc(var(--nav-h) + 3.5em) 1em 5em;
	}

	.post-header {
		margin-bottom: 3rem;
	}

	.post-date {
		font-size: 0.8rem;
		font-weight: 300;
		color: rgb(var(--gray));
		margin: 0 0 1rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.draft-badge {
		color: var(--accent);
		border: 1px solid var(--accent);
		padding: 0.1rem 0.4rem;
		margin-right: 0.6rem;
		border-radius: 2px;
	}

	.post-title {
		font-family: var(--font-display);
		font-size: clamp(2rem, 5vw, 3.5rem);
		font-weight: 700;
		color: rgb(var(--black));
		margin: 0 0 1.25rem;
		line-height: 1.05;
		text-transform: uppercase;
		letter-spacing: 0.02em;
	}

	.post-desc {
		font-size: 1rem;
		font-weight: 300;
		color: rgb(var(--gray));
		line-height: 1.6;
		margin: 0;
	}

	.header-rule {
		margin-top: 2rem;
		border: none;
		border-top: 1px solid rgb(var(--gray-light));
	}

	.hero-image {
		margin-bottom: 3rem;
	}

	.hero-image img {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 4px;
	}

	.prose {
		font-size: 1rem;
	}

	:global(.prose code) {
		font-family: ui-monospace, 'Cascadia Code', 'Source Code Pro', Menlo, Consolas, monospace;
		font-size: 0.85em;
	}

	:global(.prose pre code) {
		font-size: 0.82rem;
		line-height: 1.65;
	}

	:global(.prose .mermaid-diagram) {
		margin: 2.5rem 0;
		overflow-x: auto;
		text-align: center;
	}

	:global(.prose .mermaid-diagram svg) {
		max-width: 100%;
		height: auto;
	}
</style>
