---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import HeroImage from '../../components/HeroImage.astro';
import ShareButtons from '../../components/ShareButtons.astro';

export async function getStaticPaths() {
	const projects = await getCollection('build');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: project,
	}));
}

type Props = CollectionEntry<'build'>;

const project = Astro.props;
const { title, description, pubDate, status, heroImage, heroTitle, subtitle } = project.data;
const { Content } = await render(project);

const heroBgSrc = heroImage ?? null;

const ogImage = heroImage
	? new URL(heroImage, Astro.site).href
	: new URL('/og-default.png', Astro.site).href;

const shareText = `${title}${description ? ` - ${description}` : ''}`;
---

<BaseLayout title={title} description={description} ogImage={ogImage} ogType="article">
	{heroBgSrc && <HeroImage heroImage={heroBgSrc} heroTitle={heroTitle ?? title} />}

	<main class="build-post">
		<article>
			{
				heroBgSrc ? (
					<div class="post-header">
						<h1>{title}</h1>
						<div class="post-meta">
							<span class="status" data-status={status}>
								{status === 'ongoing' ? 'Ongoing' : 'Completed'}
							</span>
							<FormattedDate date={pubDate} />
						</div>
						{subtitle && <p class="post-subtitle">{subtitle}</p>}
						<ShareButtons title={shareText} url={Astro.url.href} />
					</div>
				) : (
					<div class="prose article-header">
						<h1>{title}</h1>
						<div class="meta">
							<span class="status" data-status={status}>
								{status === 'ongoing' ? 'Ongoing' : 'Completed'}
							</span>
							<FormattedDate date={pubDate} />
						</div>
						{subtitle && <p class="article-subtitle">{subtitle}</p>}
					</div>
				)
			}
			<div class="prose">
				<Content />
			</div>
		</article>
	</main>
</BaseLayout>

<style>
	.build-post {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
	}

	/* ─── Post header (below hero) ─── */
	.post-header {
		max-width: 720px;
		margin: 0 auto;
		text-align: center;
		padding: 3.5rem 1rem 2rem;
	}

	.post-header h1 {
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		color: rgb(var(--black));
		margin: 0 0 0.9rem;
		line-height: 1.15;
		font-weight: 700;
	}

	.post-meta {
		display: flex;
		gap: 1.5rem;
		justify-content: center;
		flex-wrap: wrap;
		align-items: center;
		color: rgb(var(--gray));
		font-size: 0.78rem;
		font-weight: 300;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.status {
		display: inline-block;
		padding: 0.2rem 0.5rem;
		border-radius: 2px;
		background: rgb(var(--gray-light));
		font-size: 0.68rem;
		font-weight: 400;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: rgb(var(--gray));
	}

	.status[data-status='ongoing'] {
		color: var(--accent);
		background: rgba(201, 169, 110, 0.1);
	}

	.post-subtitle {
		color: rgb(var(--gray));
		font-size: 0.95rem;
		font-weight: 300;
		font-style: italic;
		margin-top: 1rem;
		margin-bottom: 0;
	}

	.article-subtitle {
		color: rgb(var(--gray));
		font-size: 0.95rem;
		font-weight: 300;
		font-style: italic;
		margin-top: 0.5rem;
		margin-bottom: 1rem;
	}

	/* ─── Prose ─── */
	main {
		width: 100%;
	}

	.prose {
		padding: 0 1rem;
	}

	/* Fallback header when no hero image */
	.article-header {
		padding-top: var(--nav-h);
	}

	.article-header h1 {
		margin-bottom: 0.25rem;
	}

	.article-header .meta {
		display: flex;
		gap: 1.5rem;
		flex-wrap: wrap;
		align-items: center;
		color: rgb(var(--gray));
		font-size: 0.95rem;
		margin-bottom: 2rem;
	}
</style>
