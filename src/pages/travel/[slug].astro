---
import { Image, getImage } from 'astro:assets';
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';

export async function getStaticPaths() {
	const posts = await getCollection('travel');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

type Props = CollectionEntry<'travel'>;

const post = Astro.props;
const { title, description, subtitle, pubDate, country, distance, heroImage, heroTitle, gallery } = post.data;
const { Content } = await render(post);

// Hero background URL for CSS parallax (full-res, not displayed via <img>).
const heroBgSrc = heroImage ?? null;

// Generate full-res URLs for the lightbox at build time.
const galleryImages = gallery
	? await Promise.all(
			gallery.map(async (photo) => ({
				photo,
				fullSrc: (await getImage({ src: photo, width: 1800, format: 'webp', quality: 88 })).src,
			})),
		)
	: [];

// Generate OG image URL
const ogImage = heroImage
	? new URL(heroImage, Astro.site).href
	: new URL('/og-default.png', Astro.site).href;

// Share text for social media
const shareText = `${title}${description ? ` — ${description}` : ''}`;
---

<BaseLayout title={title} description={description} ogImage={ogImage} ogType="article">
	{
		heroBgSrc && (
			<div class="hero">
				<div class="hero-bg" id="hero-bg" style={`background-image: url('${heroBgSrc}')`} />
				<div class="hero-content">
					<h1 class="hero-title">{heroTitle ?? title}</h1>
				</div>
			</div>
		)
	}

	<main class="travel-post">
		<article>
			{
				heroBgSrc ? (
					<div class="post-header">
						<h1>{title}</h1>
						<div class="post-meta">
							<span>{country}</span>
							{!!distance && <span>{distance} km</span>}
							<FormattedDate date={pubDate} />
						</div>
						{subtitle && <p class="post-subtitle">{subtitle}</p>}
						<div class="share-section">
							<span class="share-label">SHARE</span>
							<div class="share-buttons">
								<a href={`https://twitter.com/intent/tweet?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent(shareText)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on X" class="share-btn">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" stroke="none"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
								</a>
								<a href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook" class="share-btn">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" stroke="none"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
								</a>
								<a href={`https://wa.me/?text=${encodeURIComponent(`${shareText} ${Astro.url.href}`)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on WhatsApp" class="share-btn">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" stroke="none"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
								</a>
								<a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(Astro.url.href)}`} target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn" class="share-btn">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" stroke="none"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
								</a>
								<a href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(Astro.url.href)}`} aria-label="Share via email" class="share-btn">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" stroke="none"><path d="M2 4a2 2 0 012-2h16a2 2 0 012 2v16a2 2 0 01-2 2H4a2 2 0 01-2-2V4zm2 0l8 8 8-8H4zm0 2v12h16V6l-8 8-8-8z"/></svg>
								</a>
								<button class="share-btn copy-link" id="copy-link-btn" aria-label="Copy link">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" fill="currentColor" stroke="none"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/></svg>
								</button>
							</div>
						</div>
					</div>
				) : (
					<div class="prose article-header">
						<h1>{title}</h1>
						<div class="meta">
							<span>{country}</span>
							{!!distance && <span>{distance} km</span>}
							<FormattedDate date={pubDate} />
						</div>
						{subtitle && <p class="article-subtitle">{subtitle}</p>}
					</div>
				)
			}
			<div class="prose">
				<Content />
			</div>
		</article>
	</main>

	{
		galleryImages.length > 0 && (
			<>
				<section class="gallery-section" aria-label="Photo gallery">
					<p class="gallery-label">{galleryImages.length} photographs</p>
					<div class="masonry">
						{galleryImages.map(({ photo, fullSrc }, index) => (
							<button
								class="masonry-item"
								data-index={String(index)}
								data-full-src={fullSrc}
								data-w={String(photo.width)}
								data-h={String(photo.height)}
								aria-label={`Open photo ${index + 1} of ${galleryImages.length}`}
							>
								<Image src={photo} alt="" width={800} loading="lazy" />
							</button>
						))}
					</div>
				</section>

				<div
					id="lightbox"
					class="lightbox"
					aria-hidden="true"
					aria-modal="true"
					role="dialog"
					aria-label="Photo viewer"
				>
					<div class="lightbox-bg" id="lightbox-bg" />
					<button class="lightbox-close" id="lightbox-close" aria-label="Close">
						<svg
							width="22"
							height="22"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							aria-hidden="true"
						>
							<line x1="18" y1="6" x2="6" y2="18" />
							<line x1="6" y1="6" x2="18" y2="18" />
						</svg>
					</button>
					<button class="lightbox-nav lightbox-prev" id="lightbox-prev" aria-label="Previous photo">
						<svg
							width="28"
							height="28"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.25"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<polyline points="15 18 9 12 15 6" />
						</svg>
					</button>
					<button class="lightbox-nav lightbox-next" id="lightbox-next" aria-label="Next photo">
						<svg
							width="28"
							height="28"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.25"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<polyline points="9 18 15 12 9 6" />
						</svg>
					</button>
					<div class="lightbox-frame" id="lightbox-frame">
						<img id="lightbox-img" src="" alt="" />
					</div>
					<span class="lightbox-counter" id="lightbox-counter" aria-live="polite" />
				</div>
			</>
		)
	}
</BaseLayout>

<style>
	/* ─── Travel post container ─── */
	.travel-post {
		width: 720px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
	}

	/* ─── Hero ─── */
	.hero {
		position: relative;
		width: 100%;
		height: 100vh;
		overflow: hidden;
		background-color: #111;
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		background-size: cover;
		background-position: center bottom;
		will-change: transform;
	}

	.hero-content {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 1;
	}

	.hero-title {
		font-family: var(--font-display);
		font-size: clamp(5rem, 6vw, 10rem);
		color: #fff;
		margin: 0;
		line-height: 1.1;
		font-weight: 700;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		text-align: center;
		padding: 0 2rem;
	}

	/* ─── Post header (below hero) ─── */
	.post-header {
		max-width: 720px;
		margin: 0 auto;
		text-align: center;
		padding: 3.5rem 1rem 2rem;
	}

	.post-header h1 {
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		color: rgb(var(--black));
		margin: 0 0 0.9rem;
		line-height: 1.15;
		font-weight: 700;
	}

	.post-meta {
		display: flex;
		gap: 1.5rem;
		justify-content: center;
		flex-wrap: wrap;
		color: rgb(var(--gray));
		font-size: 0.78rem;
		font-weight: 300;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.post-subtitle {
		color: rgb(var(--gray));
		font-size: 0.95rem;
		font-weight: 300;
		font-style: italic;
		margin-top: 1rem;
		margin-bottom: 0;
	}

	.article-subtitle {
		color: rgb(var(--gray));
		font-size: 0.95rem;
		font-weight: 300;
		font-style: italic;
		margin-top: 0.5rem;
		margin-bottom: 1rem;
	}

	/* ─── Share section ─── */
	.share-section {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
		margin-top: 2rem;
		padding-top: 2rem;
		border-top: 1px solid rgba(255, 255, 255, 0.08);
	}

	.share-label {
		font-size: 0.65rem;
		letter-spacing: 0.15em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.25);
		font-weight: 500;
	}

	.share-buttons {
		display: flex;
		gap: 1.25rem;
		justify-content: center;
	}

	.share-btn {
		width: 22px;
		height: 22px;
		display: flex;
		align-items: center;
		justify-content: center;
		color: rgba(255, 255, 255, 0.4);
		background: none;
		border: none;
		cursor: pointer;
		transition: color 0.2s;
		padding: 0;
	}

	.share-btn svg {
		width: 100%;
		height: 100%;
		fill: currentColor;
	}

	.share-btn:hover {
		color: rgba(255, 255, 255, 0.9);
	}

	/* ─── Prose ─── */
	main {
		width: 100%;
	}

	.prose {
		padding: 0 1rem;
	}

	/* Fallback header when no hero image */
	.article-header {
		padding-top: var(--nav-h);
	}

	.article-header h1 {
		margin-bottom: 0.25rem;
	}

	.article-header .meta {
		display: flex;
		gap: 1.5rem;
		flex-wrap: wrap;
		color: rgb(var(--gray));
		font-size: 0.95rem;
		margin-bottom: 2rem;
	}

	/* ─── Gallery section ─── */
	.gallery-section {
		background: #0f0f0f;
		padding: 5rem 0 6rem;
		margin-top: 5rem;
	}

	.gallery-label {
		text-align: center;
		color: rgba(255, 255, 255, 0.18);
		font-size: 0.7rem;
		font-weight: 300;
		letter-spacing: 0.25em;
		text-transform: uppercase;
		margin-bottom: 3rem;
	}

	/* ─── Masonry ─── */
	.masonry {
		max-width: 1440px;
		margin: 0 auto;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		grid-auto-rows: 4px;
		gap: 3px;
		padding: 0 3px;
	}

	.masonry-item {
		overflow: hidden;
		cursor: zoom-in;
		border: none;
		padding: 0;
		background: transparent;
		display: block;
	}

	.masonry-item img {
		width: 100%;
		height: auto;
		display: block;
		border-radius: 0;
		transition:
			transform 0.5s cubic-bezier(0.25, 0, 0.25, 1),
			opacity 0.4s ease;
	}

	.masonry-item:hover img {
		transform: scale(1.02);
		opacity: 0.88;
	}

	/* ─── Lightbox ─── */
	.lightbox {
		position: fixed;
		inset: 0;
		z-index: 9999;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.3s ease;
	}

	.lightbox.is-open {
		opacity: 1;
		pointer-events: auto;
	}

	.lightbox-bg {
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.97);
		cursor: zoom-out;
	}

	.lightbox-frame {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		transform: scale(0.96);
		transition: transform 0.35s cubic-bezier(0.25, 0, 0.25, 1);
		pointer-events: none;
	}

	.lightbox.is-open .lightbox-frame {
		transform: scale(1);
	}

	.lightbox-frame img {
		max-width: 90vw;
		max-height: 90vh;
		object-fit: contain;
		display: block;
		border-radius: 0;
		transition: opacity 0.2s ease;
	}

	.lightbox-close {
		position: absolute;
		top: 1.25rem;
		right: 1.5rem;
		z-index: 2;
		color: rgba(255, 255, 255, 0.45);
		background: none;
		border: none;
		cursor: pointer;
		padding: 0.5rem;
		line-height: 0;
		transition: color 0.2s ease;
	}

	.lightbox-close:hover {
		color: rgba(255, 255, 255, 0.9);
	}

	.lightbox-nav {
		position: absolute;
		top: 50%;
		transform: translateY(-50%);
		z-index: 2;
		color: rgba(255, 255, 255, 0.3);
		background: none;
		border: none;
		cursor: pointer;
		padding: 2rem 1.5rem;
		line-height: 0;
		transition: color 0.2s ease;
	}

	.lightbox-nav:hover {
		color: rgba(255, 255, 255, 0.85);
	}

	.lightbox-prev {
		left: 0;
	}

	.lightbox-next {
		right: 0;
	}

	.lightbox-counter {
		position: absolute;
		bottom: 1.5rem;
		left: 50%;
		transform: translateX(-50%);
		z-index: 2;
		color: rgba(255, 255, 255, 0.25);
		font-size: 0.7rem;
		font-weight: 300;
		letter-spacing: 0.2em;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
	}

	@media (max-width: 1024px) {
		.masonry {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 640px) {
		.masonry {
			grid-template-columns: 1fr;
			grid-auto-rows: auto;
		}

		.gallery-section {
			padding: 3rem 0 4rem;
		}

		.lightbox-nav {
			padding: 1.5rem 1rem;
		}
	}
</style>

<script>
	// ─── Hero parallax ───
	const heroBg = document.getElementById('hero-bg');
	if (heroBg) {
		let ticking = false;
		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					requestAnimationFrame(() => {
						(heroBg as HTMLElement).style.transform = `translateY(${window.scrollY * 0.4}px)`;
						ticking = false;
					});
					ticking = true;
				}
			},
			{ passive: true },
		);
	}

	// ─── Masonry row-span calculation ───
	const GAP = 3;
	const ROW_H = 4;

	function calcSpans() {
		const grid = document.querySelector<HTMLElement>('.masonry');
		if (!grid) return;
		const cols = getComputedStyle(grid).gridTemplateColumns.split(' ').length;
		if (cols === 1) {
			grid.querySelectorAll<HTMLElement>('.masonry-item').forEach((item) => {
				item.style.gridRowEnd = '';
			});
			return;
		}
		const colW = (grid.offsetWidth - GAP * (cols - 1) - GAP * 2) / cols;
		grid.querySelectorAll<HTMLElement>('.masonry-item').forEach((item) => {
			const w = Number(item.dataset.w);
			const h = Number(item.dataset.h);
			if (!w || !h) return;
			const renderedH = (h / w) * colW;
			item.style.gridRowEnd = `span ${Math.ceil((renderedH + GAP) / (ROW_H + GAP))}`;
		});
	}

	calcSpans();
	window.addEventListener('resize', calcSpans);

	// ─── Lightbox ───
	const el = document.getElementById('lightbox');
	if (el) {
		const img = document.getElementById('lightbox-img') as HTMLImageElement;
		const counter = document.getElementById('lightbox-counter')!;
		const items = Array.from(document.querySelectorAll<HTMLButtonElement>('.masonry-item'));
		const fullSrcs = items.map((item) => item.dataset.fullSrc ?? '');
		const thumbSrcs = items.map((item) => item.querySelector('img')?.src ?? '');

		let current = 0;
		let isOpen = false;

		function preload(index: number) {
			const p = new window.Image();
			p.src = fullSrcs[index];
		}

		function setPhoto(index: number, src: string) {
			img.style.opacity = '0';
			const loader = new window.Image();
			loader.onload = () => {
				if (current === index) {
					img.src = loader.src;
					img.style.opacity = '1';
				}
			};
			img.src = src;
			if (img.complete && img.naturalWidth > 0) img.style.opacity = '1';
			loader.src = src;
			counter.textContent = `${index + 1} / ${items.length}`;
		}

		function open(index: number) {
			current = index;
			isOpen = true;
			setPhoto(index, thumbSrcs[index]);
			const loader = new window.Image();
			loader.onload = () => {
				if (current === index && isOpen) setPhoto(index, loader.src);
			};
			loader.src = fullSrcs[index];
			el.classList.add('is-open');
			el.setAttribute('aria-hidden', 'false');
			document.body.style.overflow = 'hidden';
			preload((index + 1) % items.length);
			preload((index - 1 + items.length) % items.length);
		}

		function close() {
			isOpen = false;
			el.classList.remove('is-open');
			el.setAttribute('aria-hidden', 'true');
			document.body.style.overflow = '';
			setTimeout(() => {
				img.src = '';
				img.style.opacity = '0';
			}, 350);
		}

		function navigate(delta: number) {
			const next = (current + delta + items.length) % items.length;
			current = next;
			setPhoto(next, thumbSrcs[next]);
			const loader = new window.Image();
			loader.onload = () => {
				if (current === next && isOpen) setPhoto(next, loader.src);
			};
			loader.src = fullSrcs[next];
			preload((next + 1) % items.length);
			preload((next - 1 + items.length) % items.length);
		}

		items.forEach((item, i) => item.addEventListener('click', () => open(i)));
		document.getElementById('lightbox-bg')!.addEventListener('click', close);
		document.getElementById('lightbox-close')!.addEventListener('click', close);
		document.getElementById('lightbox-prev')!.addEventListener('click', () => navigate(-1));
		document.getElementById('lightbox-next')!.addEventListener('click', () => navigate(1));

		document.addEventListener('keydown', (e) => {
			if (!isOpen) return;
			if (e.key === 'Escape') close();
			if (e.key === 'ArrowLeft') navigate(-1);
			if (e.key === 'ArrowRight') navigate(1);
		});
	}

	// ─── Copy link to clipboard ───
	const copyLinkBtn = document.getElementById('copy-link-btn');
	if (copyLinkBtn) {
		copyLinkBtn.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(window.location.href);
				const originalText = copyLinkBtn.innerHTML;
				copyLinkBtn.innerHTML = '<span style="font-size: 0.6rem; color: rgba(255,255,255,0.6); position: absolute;">Copied!</span>';
				setTimeout(() => {
					copyLinkBtn.innerHTML = originalText;
				}, 2000);
			} catch (err) {
				console.error('Failed to copy:', err);
			}
		});
	}
</script>
