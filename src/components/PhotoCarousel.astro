---
import { Image } from 'astro:assets';

interface PhotoEntry {
	src: ImageMetadata;
	alt: string;
	caption?: string;
}

interface Props {
	images: PhotoEntry[];
	aspect?: string;
}

const { images, aspect = '1/1' } = Astro.props;
const single = images.length === 1;
const carouselId = `carousel-${Math.random().toString(36).substr(2, 9)}`;
---

<div class="carousel" data-carousel data-carousel-id={carouselId}>
	<div class="carousel-outer" style={`--carousel-aspect: ${aspect ?? '1/1'}`}>
		<div class="carousel-track">
			{
				!single && (
					<button class="carousel-prev" aria-label="Previous photo">
						‹
					</button>
				)
			}

			<div class="carousel-square">
				<div class="carousel-inner">
					{
						images.map(({ src, alt, caption }, i) => (
							<figure
								class={`carousel-slide${i === 0 ? ' is-active' : ''}`}
								role="group"
								aria-roledescription="slide"
								aria-label={`${i + 1} of ${images.length}`}
								aria-hidden={i !== 0 ? 'true' : undefined}
							>
								<button class="carousel-slide-button" data-carousel-image={String(i)} data-carousel-src={src.src} aria-label="View fullscreen">
									<Image
										src={src}
										alt={alt}
										widths={[600, 900, 1200]}
										sizes="(max-width: 720px) 100vw, 720px"
									/>
								</button>
								{caption && <figcaption>{caption}</figcaption>}
							</figure>
						))
					}
				</div>
			</div>

			{
				!single && (
					<button class="carousel-next" aria-label="Next photo">
						›
					</button>
				)
			}
		</div>

		{
			!single && (
				<div class="carousel-meta">
					<span class="carousel-caption"></span>
					<span class="carousel-counter" data-counter></span>
				</div>
			)
		}

		{
			!single && (
				<div class="carousel-nav-mobile">
					<button class="carousel-prev-mobile" aria-label="Previous photo">‹</button>
					<button class="carousel-next-mobile" aria-label="Next photo">›</button>
				</div>
			)
		}
	</div>

	{/* Lightbox — scoped to this carousel */}
	<div class="carousel-lightbox" data-lightbox-for={carouselId}>
		<button class="lightbox-close" aria-label="Close lightbox">×</button>
		<button class="lightbox-prev" aria-label="Previous photo">‹</button>
		<div class="lightbox-content">
			<img class="lightbox-img lightbox-img-1 is-active" src="" alt="" />
			<img class="lightbox-img lightbox-img-2" src="" alt="" />
			<p class="lightbox-caption"></p>
		</div>
		<button class="lightbox-next" aria-label="Next photo">›</button>
	</div>
</div>

<style>
	.carousel {
		position: relative;
	}

	/* Outer container — prose column width */
	.carousel-outer {
		width: 100%;
		margin: 2rem 0;
	}

	/* Track — flex row with arrows and square */
	.carousel-track {
		display: flex;
		flex-direction: row;
		align-items: stretch;
		width: 100%;
		gap: 0;
	}

	/* Square image container */
	.carousel-square {
		aspect-ratio: var(--carousel-aspect, 1/1);
		flex: 1;
		min-width: 0;
		position: relative;
		overflow: hidden;
		background: var(--color-bg, #0f0f0f);
	}

	.carousel-inner {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--color-bg, #0f0f0f);
		position: relative;
	}

	/* Slides inside square */
	.carousel-slide {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transition: opacity 600ms ease-in-out;
	}

	.carousel-slide.is-active {
		opacity: 1;
		pointer-events: auto;
	}

	.carousel-slide-button {
		all: unset;
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: zoom-in;
	}

	.carousel-img {
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		object-fit: contain;
		display: block;
	}

	.carousel-slide img {
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		object-fit: contain;
		display: block;
	}

	.carousel-slide figcaption {
		display: none;
	}

	/* Navigation arrows — fixed width, full height */
	.carousel-prev,
	.carousel-next {
		flex-shrink: 0;
		width: 2rem;
		display: flex;
		align-items: center;
		justify-content: center;
		background: none;
		border: none;
		color: rgba(255, 255, 255, 0.35);
		font-size: 1.2rem;
		cursor: pointer;
		padding: 0;
		transition: color 0.2s;
		align-self: stretch;
	}

	.carousel-prev:hover,
	.carousel-next:hover {
		color: rgba(255, 255, 255, 0.8);
	}

	.carousel-prev:focus-visible,
	.carousel-next:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}

	/* Meta below carousel */
	.carousel-meta {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		margin-top: 0.6rem;
		padding: 0 2rem;
	}

	.carousel-caption {
		font-size: 0.75rem;
		color: rgba(255, 255, 255, 0.4);
		text-align: center;
		font-family: var(--font-body, 'DM Sans', sans-serif);
		letter-spacing: 0.02em;
	}

	.carousel-counter {
		font-size: 0.6rem;
		color: rgba(255, 255, 255, 0.2);
		letter-spacing: 0.12em;
		text-align: center;
		font-family: var(--font-body, 'DM Sans', sans-serif);
	}

	/* Mobile nav — hidden on desktop, shown on mobile */
	.carousel-nav-mobile {
		display: none;
	}

	/* Lightbox */
	.carousel-lightbox {
		display: none;
		position: fixed;
		inset: 0;
		z-index: 9999;
		background: rgba(0, 0, 0, 0.95);
		align-items: center;
		justify-content: center;
	}

	.carousel-lightbox.open {
		display: flex;
	}

	.lightbox-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1rem;
		position: relative;
	}

	.lightbox-img {
		max-width: 72vw;
		max-height: 78vh;
		object-fit: contain;
		display: block;
		border-radius: 0;
		position: absolute;
		opacity: 0;
		transition: opacity 400ms ease-in-out;
	}

	.lightbox-img.is-active {
		position: relative;
		opacity: 1;
	}

	.lightbox-caption {
		color: rgba(255, 255, 255, 0.5);
		font-size: 0.8rem;
		font-family: var(--font-body, 'DM Sans', sans-serif);
		letter-spacing: 0.03em;
		text-align: center;
		max-width: 60ch;
		margin: 0;
	}

	.lightbox-caption:empty {
		display: none;
	}

	.lightbox-close {
		position: fixed;
		top: 1.5rem;
		right: 1.5rem;
		width: 2.5rem;
		height: 2.5rem;
		font-size: 2rem;
		background: none;
		border: none;
		color: rgba(255, 255, 255, 0.7);
		cursor: pointer;
		line-height: 1;
		padding: 0;
		transition: color 0.2s ease;
		z-index: 10000;
	}

	.lightbox-close:hover {
		color: rgba(255, 255, 255, 1);
	}

	.lightbox-prev,
	.lightbox-next {
		position: fixed;
		top: 50%;
		transform: translateY(-50%);
		font-size: 2.5rem;
		background: none;
		border: none;
		color: rgba(255, 255, 255, 0.5);
		cursor: pointer;
		padding: 1rem;
		line-height: 1;
		user-select: none;
		transition: color 0.2s ease;
		z-index: 10000;
	}

	.lightbox-prev:hover,
	.lightbox-next:hover {
		color: rgba(255, 255, 255, 0.9);
	}

	.lightbox-prev {
		left: 1rem;
	}

	.lightbox-next {
		right: 1rem;
	}

	/* Mobile (max-width: 640px) */
	@media (max-width: 640px) {
		.carousel-track {
			flex-direction: column;
		}

		/* Hide side arrows on mobile */
		.carousel-prev,
		.carousel-next {
			display: none;
		}

		/* Show mobile nav */
		.carousel-nav-mobile {
			display: flex;
			gap: 2rem;
			justify-content: center;
			padding-top: 0.5rem;
		}

		.carousel-prev-mobile,
		.carousel-next-mobile {
			width: 40px;
			flex-shrink: 0;
			display: flex;
			align-items: center;
			justify-content: center;
			background: none;
			border: none;
			color: rgba(255, 255, 255, 0.4);
			font-size: 1.5rem;
			cursor: pointer;
			padding: 0;
			transition: color 0.2s;
			line-height: 1;
		}

		.carousel-prev-mobile:hover,
		.carousel-next-mobile:hover {
			color: rgba(255, 255, 255, 0.9);
		}

		.carousel-prev-mobile:focus-visible,
		.carousel-next-mobile:focus-visible {
			outline: 2px solid var(--accent);
			outline-offset: 2px;
		}

		.lightbox-prev,
		.lightbox-next {
			font-size: 1.75rem;
			padding: 0.75rem;
		}
	}
</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		// Find all carousels on the page
		document.querySelectorAll('[data-carousel]').forEach((carouselEl) => {
			const carouselId = carouselEl.getAttribute('data-carousel-id');
			if (!carouselId) return;

			const slides = Array.from(carouselEl.querySelectorAll('.carousel-slide'));
			const prevBtn = carouselEl.querySelector('.carousel-prev');
			const nextBtn = carouselEl.querySelector('.carousel-next');
			const prevMobileBtn = carouselEl.querySelector('.carousel-prev-mobile');
			const nextMobileBtn = carouselEl.querySelector('.carousel-next-mobile');
			const captionEl = carouselEl.querySelector('.carousel-caption');
			const counterEl = carouselEl.querySelector('.carousel-counter');
			const lightbox = carouselEl.querySelector(`[data-lightbox-for="${carouselId}"]`);
			const lightboxImg1 = lightbox?.querySelector('.lightbox-img-1');
			const lightboxImg2 = lightbox?.querySelector('.lightbox-img-2');
			const lightboxCaption = lightbox?.querySelector('.lightbox-caption');
			const lightboxPrev = lightbox?.querySelector('.lightbox-prev');
			const lightboxNext = lightbox?.querySelector('.lightbox-next');
			const lightboxClose = lightbox?.querySelector('.lightbox-close');

			if (slides.length <= 1) return;

			let current = 0;
			let lightboxCurrent = 0;

			function updateCaption() {
				if (!captionEl) return;
				const slide = slides[current];
				const figcaption = slide.querySelector('figcaption');
				captionEl.textContent = figcaption?.textContent ?? '';
			}

			function updateCounter() {
				if (!counterEl) return;
				counterEl.textContent = `${current + 1} / ${slides.length}`;
			}

			function goTo(index: number) {
				const next = ((index % slides.length) + slides.length) % slides.length;

				slides[current].classList.remove('is-active');
				slides[current].setAttribute('aria-hidden', 'true');

				current = next;

				slides[current].classList.add('is-active');
				slides[current].removeAttribute('aria-hidden');

				updateCaption();
				updateCounter();
			}

			function updateLightboxCaption() {
				if (!lightboxCaption) return;
				const slide = slides[lightboxCurrent];
				const figcaption = slide.querySelector('figcaption');
				lightboxCaption.textContent = figcaption?.textContent ?? '';
			}

			function openLightbox(index: number) {
				if (!lightbox || !lightboxImg1) return;
				lightboxCurrent = index;
				const slide = slides[index];
				const btn = slide.querySelector('[data-carousel-image]');
				const src = btn?.getAttribute('data-carousel-src');
				if (src) {
					lightboxImg1.src = src;
					lightboxImg1.classList.add('is-active');
					if (lightboxImg2) lightboxImg2.classList.remove('is-active');
				}
				updateLightboxCaption();
				lightbox.classList.add('open');
				document.body.style.overflow = 'hidden';
			}

			function closeLightbox() {
				if (!lightbox) return;
				lightbox.classList.remove('open');
				document.body.style.overflow = '';
			}

			function lightboxNavigate(delta: number) {
				const next = ((lightboxCurrent + delta) % slides.length + slides.length) % slides.length;
				lightboxCurrent = next;
				const slide = slides[next];
				const btn = slide.querySelector('[data-carousel-image]');
				const src = btn?.getAttribute('data-carousel-src');
				if (src) {
					// Get the currently active image
					const activeImg = lightboxImg1?.classList.contains('is-active') ? lightboxImg1 : lightboxImg2;
					const inactiveImg = activeImg === lightboxImg1 ? lightboxImg2 : lightboxImg1;

					// Swap images and trigger cross-fade
					if (inactiveImg && activeImg) {
						inactiveImg.src = src;
						activeImg.classList.remove('is-active');
						inactiveImg.classList.add('is-active');
					}
				}
				updateLightboxCaption();
			}

			// Carousel navigation
			prevBtn?.addEventListener('click', () => goTo(current - 1));
			nextBtn?.addEventListener('click', () => goTo(current + 1));
			prevMobileBtn?.addEventListener('click', () => goTo(current - 1));
			nextMobileBtn?.addEventListener('click', () => goTo(current + 1));

			// Click to open lightbox
			slides.forEach((slide, index) => {
				const btn = slide.querySelector('.carousel-slide-button');
				btn?.addEventListener('click', () => openLightbox(index));
			});

			// Lightbox controls
			lightboxClose?.addEventListener('click', closeLightbox);
			lightboxPrev?.addEventListener('click', () => lightboxNavigate(-1));
			lightboxNext?.addEventListener('click', () => lightboxNavigate(1));
			lightbox?.addEventListener('click', (e) => {
				if (e.target === lightbox) closeLightbox();
			});

			// Keyboard navigation
			carouselEl.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowLeft') {
					e.preventDefault();
					goTo(current - 1);
				} else if (e.key === 'ArrowRight') {
					e.preventDefault();
					goTo(current + 1);
				}
			});

			document.addEventListener('keydown', (e) => {
				if (!lightbox?.classList.contains('open')) return;
				if (e.key === 'Escape') closeLightbox();
				if (e.key === 'ArrowLeft') {
					e.preventDefault();
					lightboxNavigate(-1);
				} else if (e.key === 'ArrowRight') {
					e.preventDefault();
					lightboxNavigate(1);
				}
			});

			// Touch/swipe
			let startX = 0;
			let startY = 0;
			let axis: 'h' | 'v' | null = null;

			carouselEl.addEventListener(
				'touchstart',
				(e) => {
					startX = e.touches[0].clientX;
					startY = e.touches[0].clientY;
					axis = null;
				},
				{ passive: true },
			);

			carouselEl.addEventListener(
				'touchmove',
				(e) => {
					if (axis === null) {
						const dx = Math.abs(e.touches[0].clientX - startX);
						const dy = Math.abs(e.touches[0].clientY - startY);
						if (dx > 4 || dy > 4) axis = dx >= dy ? 'h' : 'v';
					}
					if (axis === 'h') e.preventDefault();
				},
				{ passive: false },
			);

			carouselEl.addEventListener('touchend', (e) => {
				if (axis !== 'h') return;
				const dx = startX - e.changedTouches[0].clientX;
				if (Math.abs(dx) > 40) goTo(current + (dx > 0 ? 1 : -1));
				axis = null;
			});

			updateCaption();
			updateCounter();
		});
	});
</script>
